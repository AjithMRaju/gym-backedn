# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/gym_website
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/gym_website

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Settings API ─────────────────────────────────────────────────────────────
# 64-char hex key used for AES-256-GCM encryption of secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=your_64_char_hex_key_here

# Application name used in 2FA QR code labels
APP_NAME=GymAdmin

# ─── Testing ──────────────────────────────────────────────────────────────────
# Separate DB for integration tests (recommended)
MONGO_URI_TEST=mongodb://localhost:27017/gym_website_test
